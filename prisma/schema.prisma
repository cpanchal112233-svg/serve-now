// ServeNow — Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  TECHNICIAN
}

enum BookingStatus {
  BOOKED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum JobAssignmentStatus {
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model User {
  id                     String    @id @default(cuid())
  name                   String
  email                  String    @unique
  passwordHash           String
  role                   UserRole  @default(CUSTOMER)
  phone                  String?
  createdAt              DateTime  @default(now())
  passwordResetToken     String?   @unique
  passwordResetExpires   DateTime?

  bookingsAsCustomer Booking[]         @relation("CustomerBookings")
  technicianProfile  TechnicianProfile?
}

model Service {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  description      String
  durationMinutes  Int
  price            Decimal  @db.Decimal(10, 2)
  isActive         Boolean  @default(true)

  bookings Booking[]
}

model Booking {
  id              String         @id @default(cuid())
  bookingNumber   String         @unique
  customerId      String
  serviceId       String
  scheduledDate   DateTime       @db.Date
  scheduledTime   String
  address         String
  notes           String?
  status          BookingStatus  @default(BOOKED)
  createdAt       DateTime       @default(now())

  customer User    @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  assignments JobAssignment[]
  invoices    Invoice[]
  statusLogs  StatusLog[]
}

model TechnicianProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  isAvailable Boolean  @default(true)
  serviceArea String?
  vehicleName String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments JobAssignment[]
}

model JobAssignment {
  id            String               @id @default(cuid())
  bookingId     String
  technicianId  String
  assignedAt    DateTime             @default(now())
  eta           DateTime?
  status        JobAssignmentStatus    @default(ASSIGNED)

  booking     Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  technician  TechnicianProfile  @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([bookingId])
}

model Invoice {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  invoiceNumber String        @unique
  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model StatusLog {
  id        String         @id @default(cuid())
  bookingId String
  status    BookingStatus
  note      String?
  createdAt DateTime       @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

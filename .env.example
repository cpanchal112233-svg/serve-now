# --- Database (PostgreSQL) ---
# For local Postgres, set DATABASE_URL and set DIRECT_URL to the same value.
#
# For Neon: use the *pooler* connection for DATABASE_URL and the *direct* (non-pooler) host for DIRECT_URL.
# See: https://neon.tech/docs/guides/prisma

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/servenow?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/servenow?schema=public"

# --- Auth.js ---
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3000"

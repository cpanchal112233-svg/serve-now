# --- Database (PostgreSQL / Neon) ---
# Neon on Vercel usually sets DATABASE_URL (pooled) and DATABASE_URL_UNPOOLED (direct).
# The app adds ?pgbouncer=true to pooled Neon URLs automatically (required for Prisma + PgBouncer).
# For local Postgres, set both to the same connection string.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/servenow?schema=public"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/servenow?schema=public"

# --- Auth.js ---
AUTH_SECRET="replace-with-long-random-string"
AUTH_URL="http://localhost:3000"
